p;#34;&amp;#34;, &amp;#34;g&amp;#34;, $1); &#10; else if(tolower($1) ~ /ti?/) &#10; sum &amp;#43;= gensub(/[^0-9.]/, &amp;#34;&amp;#34;, &amp;#34;g&amp;#34;, $1)*1024; &#10; else &#10; sum &amp;#43;= $1&#10; } &#10; END{print sum &amp;#34; GiB&amp;#34;}&amp;#39;&lt;/code&gt;&lt;/pre&gt;&lt;h2 class="heading-element" id="get-the-resources-for-each-namespace"&gt;&lt;span&gt;Get the resources for each namespace&lt;/span&gt;&#10; &lt;a href="#get-the-resources-for-each-namespace" class="heading-mark"&gt;&lt;svg class="octicon octicon-link" viewBox="0 0 16 16" version="1.1" width="16" height="16" aria-hidden="true"&gt;&lt;path d="m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z"&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/a&gt;&#10;&lt;/h2&gt;&lt;pre&gt;&lt;code&gt;#!/bin/bash&#10;set -e&#10;namespaces=($(kubectl get ns --no-headers | awk &amp;#39;{print $1}&amp;#39;))&#10;for namespace in &amp;#34;${namespaces[@]}&amp;#34;; do&#10; request_cpu=$(&#10; kubectl get pods -n ${namespace} -o=jsonpath=&amp;#39;{.items[*].spec.containers[*].resources.requests.cpu}&amp;#39; | \&#10; tr -s &amp;#39;[:space:]&amp;#39; &amp;#39;\n&amp;#39; | \&#10; awk &amp;#39;BEGIN{sum=0}{&#10; if(tolower($1) ~ /mi?/) &#10; sum &amp;#43;= gensub(/[^0-9.]/, &amp;#34;&amp;#34;, &amp;#34;g&amp;#34;, $1)/1000; &#10; else &#10; sum &amp;#43;= $1&#10; } &#10; END{print sum &amp;#34; CPU Cores&amp;#34;}&amp;#39;&#10; )&#10; request_memory=$(&#10; kubectl get pods -n ${namespace} -o=jsonpath=&amp;#39;{.items[*].spec.containers[*].resources.requests.m